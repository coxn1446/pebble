# --- Server ---
NODE_ENV=development
PORT=8080
SESSION_SECRET=dev-session-secret-change-me
DEFAULT_CLIENT_URL=http://localhost:3000

# --- Database (local PostgreSQL) ---
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=pebble
DB_HOST=localhost
DB_PORT=5432
# Cloud only: DB_SCHEMA=qa|prod
# DB_SCHEMA=
# INSTANCE_CONNECTION_NAME=project:region:instance

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple Sign In (optional) ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY=

# --- Stripe (stub) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Email (stub; unused by feature requests) ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# --- Resend (feature-request mail; same shape as AuraSphere) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Pebble <you@your-verified-domain>

# --- Google Places / Maps (exposed to client via GET /api/places/key) ---
GOOGLE_PLACES_API_KEY=
# Optional Cloud Console Map ID for Advanced Markers (defaults to DEMO_MAP_ID)
# GOOGLE_MAPS_MAP_ID=

# --- Firebase (stub) ---
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Google Cloud (QA/prod) ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_STORAGE_BUCKET=

# --- Capacitor sync URLs (optional) ---
# CAP_PROD_URL=https://pebble-prod-399201808588.us-central1.run.app
# CAP_QA_URL=https://pebble-qa-399201808588.us-central1.run.app
# CAP_DEV_URL=http://localhost:3000
